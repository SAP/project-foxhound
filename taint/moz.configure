option(
    "--enable-taint-debug",
    help="Enable taint debug prints"
)

@depends("--enable-taint-debug")
def taint_debug(value):
    if value:
        return True

set_define("TAINT_DEBUG", taint_debug)
set_config("TAINT_DEBUG", taint_debug)

option(
    "--enable-taint-full-args",
    help="Record taint operation string arguments in full instead of truncating them"
)

@depends("--enable-taint-full-args")
def taint_full_args(value):
    if value:
        return True

set_define("TAINT_FULL_ARGS", taint_full_args)
set_config("TAINT_FULL_ARGS", taint_full_args)

option(
    "--enable-taint-e2e-debug",
    help="Enable end to end tainting debug prints"
)

@depends("--enable-taint-e2e-debug")
def taint_e2e_debug(value):
    if value:
        return True

set_define("DEBUG_E2E_TAINTING", taint_e2e_debug)
set_config("DEBUG_E2E_TAINTING", taint_e2e_debug)
imply_option("--enable-taint-debug", True, when=taint_e2e_debug)

set_define("JSON_NOEXCEPTION", "1")
set_define("JSON_HAS_FILESYSTEM", "0")
set_define("JSON_HAS_EXPERIMENTAL_FILESYSTEM", "0")